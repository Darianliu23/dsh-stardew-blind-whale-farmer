# 复制成 local.ps1（已在 .gitignore 里，不会提交），按需取消注释、填写本机路径。
# 不建 local.ps1 也行：会用 PATH 里的 dotnet，并自动在 Steam（包括其他盘的 Steam 库）和 GOG 的默认位置找游戏。

# 游戏目录（自动找不到时再填）
# $env:STARDEW_PATH = "D:\SteamLibrary\steamapps\common\Stardew Valley"

# 游戏目录里还没装 SMAPI 时，编译需要一份 StardewModdingAPI.dll，填它所在的文件夹
# $env:SMAPI_PATH = "D:\tools\smapi-files"

# dotnet 不在 PATH 里时（需要 .NET 6 或更新的 SDK）
# $env:DOTNET_EXE = "D:\tools\dotnet\dotnet.exe"
# $env:DOTNET_ROOT = "D:\tools\dotnet"
