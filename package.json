{
  "name": "dsh-stardew-blind-whale-farmer",
  "version": "0.1.0",
  "description": "大肥鱼种白饭（Blind Whale Farmer）星露谷模组的 DSH 插件：在 DSH 设置里调整每次游玩的游戏日 / 分钟上限、思考时冻结时间、给 AI 的额外要求和攻略文件，自动推送到游戏；可选创建一个会话预设，只让选了它的会话加载玩星露谷的工具。",
  "license": "MIT",
  "author": "Darian (https://github.com/Darianliu23)",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "stardew-valley",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darianliu23/dsh-stardew-blind-whale-farmer.git"
  },
  "homepage": "https://github.com/Darianliu23/dsh-stardew-blind-whale-farmer#readme",
  "bugs": {
    "url": "https://github.com/Darianliu23/dsh-stardew-blind-whale-farmer/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs/dsh-plugin.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4.0.0 || >=3.18.2 <4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
